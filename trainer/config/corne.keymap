/*
 * Corne 3x5+3 — Miryoku Fast Base V2 (7 layers).
 * Physically 36 keys; Corne shield expects 42 key positions:
 * each of the three 12-position rows pads one absent key per edge.
 *
 * Layer IDs: 0 Base, 1 Nav, 2 Mouse, 3 Media, 4 Num, 5 Sym, 6 Fun.
 * NOTE: This deliberately does not include miryoku.dtsi or its
 * 10-layer list, to avoid stale Tap/Extra/Button layer IDs.
 */

#include <behaviors.dtsi>
#include <behaviors/mouse_keys.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        u_lt: thumb_layer_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <180>;
            flavor = "hold-preferred";
            bindings = <&mo>, <&kp>;
        };

        boot_guard: boot_guard {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <250>;
            bindings = <&none>, <&bootloader>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "Base";
            bindings = <
                /* Row 1 */ &none   &kp Q   &kp W   &kp E   &kp R   &kp T   &kp Y   &kp U   &kp I   &kp O   &kp P   &none
                /* Row 2 */ &none   &kp A   &kp S   &kp D   &kp F   &kp G   &kp H   &kp J   &kp K   &kp L   &kp SQT   &none
                /* Row 3 */ &none   &kp Z   &kp X   &kp C   &kp V   &kp B   &kp N   &kp M   &kp COMMA   &kp DOT   &kp SLASH   &none
                /* Thumbs */ &u_lt 3 ESC   &u_lt 1 SPACE   &u_lt 2 TAB   &u_lt 5 RET   &u_lt 4 BSPC   &u_lt 6 DEL
            >;
        };

        nav {
            display-name = "Nav";
            bindings = <
                /* Row 1 */ &none   &boot_guard   &none   &none   &none   &none   &sk LCTRL   &kp LC(V)   &kp LC(C)   &kp LC(X)   &sk LSHFT   &none
                /* Row 2 */ &none   &kp LGUI   &kp LALT   &kp LCTRL   &kp LSHFT   &none   &caps_word   &kp LEFT   &kp DOWN   &kp UP   &kp RIGHT   &none
                /* Row 3 */ &none   &kp LC(Z)   &kp LC(Y)   &sk LALT   &sk LGUI   &none   &kp INS   &kp HOME   &kp PG_DN   &kp PG_UP   &kp END   &none
                /* Thumbs */ &none   &none   &none   &kp RET   &kp BSPC   &kp DEL
            >;
        };

        mouse {
            display-name = "Mouse";
            bindings = <
                /* Row 1 */ &none   &none   &none   &none   &none   &none   &kp LC(Y)   &kp LC(V)   &kp LC(C)   &kp LC(X)   &kp LC(Z)   &none
                /* Row 2 */ &none   &kp LGUI   &kp LALT   &kp LCTRL   &kp LSHFT   &none   &none   &mmv MOVE_LEFT   &mmv MOVE_DOWN   &mmv MOVE_UP   &mmv MOVE_RIGHT   &none
                /* Row 3 */ &none   &none   &kp RALT   &none   &none   &none   &none   &msc SCRL_LEFT   &msc SCRL_DOWN   &msc SCRL_UP   &msc SCRL_RIGHT   &none
                /* Thumbs */ &none   &none   &none   &mkp MB2   &mkp MB1   &mkp MB3
            >;
        };

        media {
            display-name = "Media";
            bindings = <
                /* Row 1 */ &none   &none   &none   &none   &none   &none   &out OUT_TOG   &out OUT_USB   &out OUT_BLE   &bt BT_NXT   &bt BT_PRV   &none
                /* Row 2 */ &none   &kp LGUI   &kp LALT   &kp LCTRL   &kp LSHFT   &bt BT_CLR   &none   &kp C_PREV   &kp C_VOL_DN   &kp C_VOL_UP   &kp C_NEXT   &none
                /* Row 3 */ &none   &none   &kp RALT   &none   &none   &none   &bt BT_SEL 0   &bt BT_SEL 1   &bt BT_SEL 2   &bt BT_SEL 3   &bt BT_SEL 4   &none
                /* Thumbs */ &none   &none   &none   &kp C_STOP   &kp C_PP   &kp C_MUTE
            >;
        };

        num {
            display-name = "Num";
            bindings = <
                /* Row 1 */ &none   &kp LBKT   &kp N7   &kp N8   &kp N9   &kp RBKT   &none   &none   &none   &none   &none   &none
                /* Row 2 */ &none   &kp SEMI   &kp N4   &kp N5   &kp N6   &kp EQUAL   &none   &kp LSHFT   &kp LCTRL   &kp LALT   &kp LGUI   &none
                /* Row 3 */ &none   &kp GRAVE   &kp N1   &kp N2   &kp N3   &kp BSLH   &none   &none   &none   &kp RALT   &none   &none
                /* Thumbs */ &kp DOT   &kp N0   &kp MINUS   &none   &none   &none
            >;
        };

        sym {
            display-name = "Sym";
            bindings = <
                /* Row 1 */ &none   &kp LBRC   &kp AMPS   &kp ASTRK   &kp LPAR   &kp RBRC   &none   &none   &none   &none   &none   &none
                /* Row 2 */ &none   &kp COLON   &kp DLLR   &kp PRCNT   &kp CARET   &kp PLUS   &none   &kp LSHFT   &kp LCTRL   &kp LALT   &kp LGUI   &none
                /* Row 3 */ &none   &kp TILDE   &kp EXCL   &kp AT   &kp HASH   &kp PIPE   &none   &none   &none   &kp RALT   &none   &none
                /* Thumbs */ &kp LPAR   &kp RPAR   &kp UNDER   &none   &none   &none
            >;
        };

        fun {
            display-name = "Fun";
            bindings = <
                /* Row 1 */ &none   &kp F12   &kp F7   &kp F8   &kp F9   &kp PSCRN   &none   &none   &none   &none   &none   &none
                /* Row 2 */ &none   &kp F11   &kp F4   &kp F5   &kp F6   &kp SLCK   &none   &kp LSHFT   &kp LCTRL   &kp LALT   &kp LGUI   &none
                /* Row 3 */ &none   &kp F10   &kp F1   &kp F2   &kp F3   &kp PAUSE_BREAK   &none   &none   &none   &kp RALT   &none   &none
                /* Thumbs */ &kp K_APP   &kp SPACE   &kp TAB   &none   &none   &none
            >;
        };
    };
};

&mmv {
    acceleration-exponent = <1>;
    time-to-max-speed-ms = <1500>;
    delay-ms = <0>;
};

&kscan0 {
    debounce-press-ms = <1>;
    debounce-release-ms = <5>;
};
